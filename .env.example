VITE_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
VITE_SPOTIFY_REDIRECT_URI=https://sp-live-three.vercel.app/api/callback

# public = anyone can authenticate and try it
# private = hide and block Spotify login
VITE_SPOTIFY_AUTH_MODE=public

# Local dev uses mock Spotify data by default so you can work on the pill without logging in.
# Set this to true if you want to test the real OAuth flow locally.
VITE_SPOTIFY_DEV_AUTH=false
